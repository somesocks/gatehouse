# Copy this file to local-dev.env and set an OpenAI API key for local development.
# local-dev.env is loaded only by the local-dev deployment and is not committed.
OPENAI_API_KEY=

# Select sqlite or postgres. PostgreSQL runs as an ephemeral local container.
LOCAL_DEV_DATABASE=sqlite

# Set to true to run SeaweedFS and configure Gatehouse to use its S3 endpoint.
LOCAL_DEV_USE_S3=false

# Select a bundled diagnostics profile. Leave unset or set to none to disable it.
LOCAL_DEV_DIAGNOSTICS_PROFILE=none
