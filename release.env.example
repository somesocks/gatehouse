# Copy to release.env for GHCR publishing from the release deploy shell.
# GHCR_IMAGE is the fully-qualified destination image reference.
GHCR_IMAGE=ghcr.io/OWNER/gatehouse

# GitHub username associated with GHCR_TOKEN.
GHCR_USER=GITHUB_USERNAME

# GitHub PAT (classic) with write:packages permission.
GHCR_TOKEN=
