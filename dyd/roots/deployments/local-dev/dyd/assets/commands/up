#!/usr/bin/env sh

set -eu

ASSETS_DIR="$DYD_STEM/dyd/assets"
IMAGE_DIR="$DYD_STEM/dyd/dependencies/image-gatehouse/dyd/assets"
POSTGRES_IMAGE_DIR="$DYD_STEM/dyd/dependencies/image-postgres/dyd/assets"
SEAWEEDFS_IMAGE_DIR="$DYD_STEM/dyd/dependencies/image-seaweedfs/dyd/assets"
SECRETS_DIR="$DYD_STEM/dyd/secrets"

image-local-load "$(cat "$IMAGE_DIR/image-name")" "$(cat "$IMAGE_DIR/image-tag")" "$IMAGE_DIR/oci"
export GATEHOUSE_IMAGE="localhost/$(cat "$IMAGE_DIR/image")"
local_dev_database_set=false
if [ "${LOCAL_DEV_DATABASE+x}" = x ]; then
	local_dev_database_set=true
	local_dev_database=$LOCAL_DEV_DATABASE
fi
if [ -f "$SECRETS_DIR/local-dev.env" ]; then
	# The optional file is packaged as a Dryad secret, not read from the worktree.
	set -a
	. "$SECRETS_DIR/local-dev.env"
	set +a
fi
if [ "$local_dev_database_set" = true ]; then
	export LOCAL_DEV_DATABASE=$local_dev_database
fi

case "${LOCAL_DEV_DIAGNOSTICS_PROFILE:-none}" in
  none)
    ;;
  metrics-full)
    if [ -n "${GATEHOUSE_DIAG:-}" ]; then
      printf '%s\n' "GATEHOUSE_DIAG cannot be set with LOCAL_DEV_DIAGNOSTICS_PROFILE=${LOCAL_DEV_DIAGNOSTICS_PROFILE}" >&2
      exit 2
    fi
    export GATEHOUSE_DIAG="json:$(cat "$ASSETS_DIR/diagnostics/${LOCAL_DEV_DIAGNOSTICS_PROFILE}.json")"
    ;;
  *)
    printf '%s\n' "LOCAL_DEV_DIAGNOSTICS_PROFILE must be none or metrics-full" >&2
    exit 2
    ;;
esac

case "${LOCAL_DEV_DATABASE:-sqlite}" in
  sqlite)
    database=sqlite
    ;;
  postgres)
    database=postgres
    image-local-load "$(cat "$POSTGRES_IMAGE_DIR/image-name")" "$(cat "$POSTGRES_IMAGE_DIR/image-tag")" "$POSTGRES_IMAGE_DIR/oci"
    export POSTGRES_IMAGE="localhost/$(cat "$POSTGRES_IMAGE_DIR/image")"
    ;;
  *)
    printf '%s\n' "LOCAL_DEV_DATABASE must be sqlite or postgres" >&2
    exit 2
    ;;
esac

case "${LOCAL_DEV_USE_S3:-false}" in
  false)
    storage=none
    ;;
  true)
    storage=s3
    image-local-load "$(cat "$SEAWEEDFS_IMAGE_DIR/image-name")" "$(cat "$SEAWEEDFS_IMAGE_DIR/image-tag")" "$SEAWEEDFS_IMAGE_DIR/oci"
    export SEAWEEDFS_IMAGE="localhost/$(cat "$SEAWEEDFS_IMAGE_DIR/image")"
    ;;
  *)
    printf '%s\n' "LOCAL_DEV_USE_S3 must be true or false" >&2
    exit 2
    ;;
esac

case "$database:$storage" in
  sqlite:none)
    export GATEHOUSE_CONFIG="$(cat "$ASSETS_DIR/gatehouse.yaml")"
    docker compose --project-directory "$ASSETS_DIR" --file "$ASSETS_DIR/docker-compose.yml" up -d --remove-orphans
    ;;
  sqlite:s3)
    export GATEHOUSE_CONFIG="$(cat "$ASSETS_DIR/gatehouse-s3.yaml")"
    docker compose --project-directory "$ASSETS_DIR" --file "$ASSETS_DIR/docker-compose.yml" --file "$ASSETS_DIR/docker-compose.s3.yml" up -d --remove-orphans
    ;;
  postgres:none)
    export GATEHOUSE_CONFIG="$(cat "$ASSETS_DIR/gatehouse-postgres.yaml")"
    docker compose --project-directory "$ASSETS_DIR" --file "$ASSETS_DIR/docker-compose.yml" --file "$ASSETS_DIR/docker-compose.postgres.yml" up -d --remove-orphans
    ;;
  postgres:s3)
    export GATEHOUSE_CONFIG="$(cat "$ASSETS_DIR/gatehouse-postgres-s3.yaml")"
    docker compose --project-directory "$ASSETS_DIR" --file "$ASSETS_DIR/docker-compose.yml" --file "$ASSETS_DIR/docker-compose.postgres.yml" --file "$ASSETS_DIR/docker-compose.s3.yml" up -d --remove-orphans
    ;;
esac
