#!/usr/bin/env sh

set -eu

if [ "$#" -gt 1 ]; then
	printf 'usage: z-publish-tag [remote]\n' >&2
	exit 2
fi

if [ -z "${DYD_STEM:-}" ] || [ ! -f "$DYD_STEM/dyd/traits/version" ]; then
	printf '%s\n' 'z-publish-tag must run in the release deploy shell' >&2
	exit 1
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
	printf '%s\n' 'z-publish-tag must run from a Git working tree' >&2
	exit 1
fi

version=$(cat "$DYD_STEM/dyd/traits/version")
tag="release-$version"
if ! git check-ref-format "refs/tags/$tag"; then
	printf 'invalid release tag: %s\n' "$tag" >&2
	exit 1
fi

remote=${1:-origin}
if git show-ref --verify --quiet "refs/tags/$tag"; then
	printf 'reusing existing tag %s\n' "$tag"
else
	git tag --annotate "$tag" --message "Gatehouse $version"
fi

git push "$remote" "refs/tags/$tag:refs/tags/$tag"