(import
  (weather @native:weather/v1)
  (travel @native:travel/v1)
  (let
    ((cities (list "Athens" "Berlin" "Dublin" "Helsinki" "Lisbon" "Madrid"
              "Oslo" "Paris" "Prague" "Rome" "Vienna" "Warsaw"))
     (temperature (fn (city) (list/assoc/require 'temperature_c (weather/forecast city))))
     (rain (fn (city) (list/assoc/require 'rain (weather/forecast city))))
     (fare (fn (city) (travel/fare "London" city)))
     (cheapest (fn (destinations)
       (list/fold (fn (best city) (if (< (fare city) (fare best)) city best))
         (list/first destinations) (list/rest destinations))))
     (dry (list/filter (fn (city) (not (rain city))) cities)))
    ; Full records verify proper association lists, symbol keys, and field types.
    (assert (= (weather/forecast "Paris") (list (pair 'temperature_c 18) (pair 'rain #t))))
    (assert (= (weather/forecast "Rome") (list (pair 'temperature_c 24) (pair 'rain #f))))
    (assert (= (weather/forecast "Lisbon") (list (pair 'temperature_c 22) (pair 'rain #f))))
    (assert (= (list/map temperature cities) (list 20 23 17 16 22 19 29 18 21 24 26 25)))
    (assert (= (list/map rain cities) (list #t #t #f #t #f #f #t #t #f #f #t #f)))
    (assert (= (list/map fare cities) (list 150 140 110 55 120 185 175 90 80 160 130 95)))

    ; The seven question results, including computed aggregate answers.
    (assert (= (temperature "Rome") 24))
    (assert (= (string/join (list/filter rain cities) ", ")
      "Athens, Berlin, Helsinki, Oslo, Paris, Vienna"))
    (assert (= (fare "Lisbon") 120))
    (assert (= (cheapest cities) "Helsinki"))
    (assert (= (list/fold
      (fn (best city) (if (> (temperature city) (temperature best)) city best))
      (list/first cities) (list/rest cities)) "Oslo"))
    (assert (= (cheapest dry) "Prague"))
    ; Alphabetical candidate order avoids adding a sorting module to the allowlist.
    (assert (= (string/join
      (list/filter (fn (city) (and (not (rain city)) (<= (fare city) 150)))
        cities) ", ") "Dublin, Lisbon, Prague, Warsaw"))

    (assert (= (import/search) (list @native:travel/v1 @native:weather/v1)))
    (assert (= (import/search "weather") (list @native:weather/v1)))
    (assert (= (import/search "travel") (list @native:travel/v1)))
    (assert (= (import/search "missing") null))
    (assert (string/contains? (help 'weather/forecast) "(forecast city)"))
    (assert (string/contains? (help 'weather/forecast) "temperature_c (Integer"))
    (assert (string/contains? (help 'weather/forecast) "rain (Boolean"))
    (assert (string/contains? (help 'travel/fare) "(fare origin destination)"))
    (assert (string/contains? (help 'travel/fare) "EUR"))

    (assert (= import/define null))
    (assert (error? (error/catch (import/define (@native:weather/v1 (list)) null))))
    (assert (error? (error/catch (import (http @native:net/http/v1) null))))
    (assert (error? (error/catch (import (time @native:time/v1) null))))
    (assert (error? (error/catch (import (random @native:random/v1) null))))
    (assert (= (error/value (error/catch (weather/forecast "Unknown")))
      "weather/forecast: unsupported city"))
    (assert (= (error/value (error/catch (weather/forecast "paris")))
      "weather/forecast: unsupported city"))
    (assert (= (error/value (error/catch (weather/forecast null)))
      "weather/forecast: unsupported city"))
    (assert (= (error/value (error/catch (travel/fare "Paris" "Rome")))
      "travel/fare: unsupported origin"))
    (assert (= (error/value (error/catch (travel/fare "London" "Unknown")))
      "travel/fare: unsupported destination"))
    (assert (= (error/value (error/catch (travel/fare null "Rome")))
      "travel/fare: unsupported origin"))
    (assert (= (error/value (error/catch (travel/fare "London" null)))
      "travel/fare: unsupported destination"))
    null))
