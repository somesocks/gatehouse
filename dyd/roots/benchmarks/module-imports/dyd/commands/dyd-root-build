#!/usr/bin/env sh

set -eu

SRC_DIR=$DYD_STEM
DEST_DIR=$DYD_BUILD

mkdir -p "$DEST_DIR/dyd/assets" "$DEST_DIR/dyd/commands" \
    "$DEST_DIR/dyd/dependencies" "$DEST_DIR/dyd/docs" "$DEST_DIR/dyd/requirements"
cp -R "$SRC_DIR/dyd/assets/." "$DEST_DIR/dyd/assets"
cp "$SRC_DIR/dyd/docs/about.md" "$DEST_DIR/dyd/docs/"
cp "$SRC_DIR/dyd/assets/commands/dyd-stem-run" "$DEST_DIR/dyd/commands/"
ln -s "$SRC_DIR/dyd/dependencies/gatehouse" "$DEST_DIR/dyd/dependencies/gatehouse"

printf '%s' 'env:OPENAI_API_KEY' > "$DEST_DIR/dyd/requirements/openai-api-key"
