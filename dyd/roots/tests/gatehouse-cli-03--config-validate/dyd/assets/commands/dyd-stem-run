#!/usr/bin/env bash

set -euf -o pipefail

SRC_DIR=$DYD_STEM
TEMP_DIR=''

assert_contains() {
    case "$1" in
        *"$2"*) ;;
        *)
            printf '%s\n' "[ERROR] Fail: $3 does not contain $2" >&2
            return 1
            ;;
    esac
}

_setup() {
    TEMP_DIR=$(mktemp -d 2>/dev/null || mktemp -d -t 'gatehouse-config-test')
    cp -R "$SRC_DIR/dyd/assets/fixtures/." "$TEMP_DIR"
}

_test() {
    gatehouse config validate "$TEMP_DIR/valid.yaml" >"$TEMP_DIR/valid-yaml.stdout" 2>"$TEMP_DIR/valid-yaml.stderr"
    assert_contains "$(cat "$TEMP_DIR/valid-yaml.stderr")" "configuration is valid" "YAML validation"

    gatehouse config validate "$TEMP_DIR/valid.json" >"$TEMP_DIR/valid-json.stdout" 2>"$TEMP_DIR/valid-json.stderr"
    assert_contains "$(cat "$TEMP_DIR/valid-json.stderr")" "configuration is valid" "JSON validation"

    gatehouse config validate "$TEMP_DIR/valid-sqlite.yaml" >"$TEMP_DIR/valid-sqlite.stdout" 2>"$TEMP_DIR/valid-sqlite.stderr"
    assert_contains "$(cat "$TEMP_DIR/valid-sqlite.stderr")" "configuration is valid" "SQLite database validation"
    assert_contains "$(cat "$TEMP_DIR/valid-sqlite.stderr")" "database.path" "relative SQLite warning"

    gatehouse config validate "$TEMP_DIR/valid-postgres.json" >"$TEMP_DIR/valid-postgres.stdout" 2>"$TEMP_DIR/valid-postgres.stderr"
    assert_contains "$(cat "$TEMP_DIR/valid-postgres.stderr")" "configuration is valid" "PostgreSQL database validation"

    gatehouse config validate "$TEMP_DIR/valid-ephemeral.yaml" >"$TEMP_DIR/valid-ephemeral.stdout" 2>"$TEMP_DIR/valid-ephemeral.stderr"
    assert_contains "$(cat "$TEMP_DIR/valid-ephemeral.stderr")" "configuration is valid" "ephemeral database validation"

    gatehouse config validate "$TEMP_DIR/valid-workspaces.yaml" >"$TEMP_DIR/valid-workspaces.stdout" 2>"$TEMP_DIR/valid-workspaces.stderr"
    assert_contains "$(cat "$TEMP_DIR/valid-workspaces.stderr")" "configuration is valid" "workspace validation"

    GATEHOUSE_ALICE_PASSWORD_VERIFIER=gh-ver:placeholder gatehouse config validate "$TEMP_DIR/valid-principals.yaml" >"$TEMP_DIR/valid-principals.stdout" 2>"$TEMP_DIR/valid-principals.stderr"
    assert_contains "$(cat "$TEMP_DIR/valid-principals.stderr")" "configuration is valid" "principal identity validation"

    gatehouse config validate "$TEMP_DIR/valid-groups.yaml" >"$TEMP_DIR/valid-groups.stdout" 2>"$TEMP_DIR/valid-groups.stderr"
    assert_contains "$(cat "$TEMP_DIR/valid-groups.stderr")" "configuration is valid" "group validation"

    gatehouse config validate "$TEMP_DIR/valid-services.yaml" >"$TEMP_DIR/valid-services.stdout" 2>"$TEMP_DIR/valid-services.stderr"
    assert_contains "$(cat "$TEMP_DIR/valid-services.stderr")" "configuration is valid" "service validation"

    if gatehouse config validate "$TEMP_DIR/invalid-unknown-field.yaml" >"$TEMP_DIR/invalid.stdout" 2>"$TEMP_DIR/invalid.stderr"; then
        printf '%s\n' "[ERROR] Fail: unknown-field configuration unexpectedly succeeded" >&2
        return 1
    fi
    assert_contains "$(cat "$TEMP_DIR/invalid.stderr")" "additional properties 'unexpected' not allowed" "unknown-field validation"

    if gatehouse config validate "$TEMP_DIR/invalid-database.yaml" >"$TEMP_DIR/invalid-database.stdout" 2>"$TEMP_DIR/invalid-database.stderr"; then
        printf '%s\n' "[ERROR] Fail: invalid database configuration unexpectedly succeeded" >&2
        return 1
    fi

    if gatehouse config validate "$TEMP_DIR/invalid-workspace.yaml" >"$TEMP_DIR/invalid-workspace.stdout" 2>"$TEMP_DIR/invalid-workspace.stderr"; then
        printf '%s\n' "[ERROR] Fail: invalid workspace configuration unexpectedly succeeded" >&2
        return 1
    fi
    assert_contains "$(cat "$TEMP_DIR/invalid-workspace.stderr")" "is reserved" "workspace key validation"

    if gatehouse config validate "$TEMP_DIR/invalid-matrix-password-verifier.yaml" >"$TEMP_DIR/invalid-matrix-password-verifier.stdout" 2>"$TEMP_DIR/invalid-matrix-password-verifier.stderr"; then
        printf '%s\n' "[ERROR] Fail: Matrix identity with password verifier unexpectedly succeeded" >&2
        return 1
    fi

    if gatehouse config validate "$TEMP_DIR/invalid-principal-id.yaml" >"$TEMP_DIR/invalid-principal-id.stdout" 2>"$TEMP_DIR/invalid-principal-id.stderr"; then
        printf '%s\n' "[ERROR] Fail: configuration with retired principal and identity IDs unexpectedly succeeded" >&2
        return 1
    fi

    if gatehouse config validate "$TEMP_DIR/invalid-group-member-principal-id.yaml" >"$TEMP_DIR/invalid-group-member-principal-id.stdout" 2>"$TEMP_DIR/invalid-group-member-principal-id.stderr"; then
        printf '%s\n' "[ERROR] Fail: group member with principal_id unexpectedly succeeded" >&2
        return 1
    fi

    if gatehouse config validate "$TEMP_DIR/invalid-http-listen.yaml" >"$TEMP_DIR/invalid-http-listen.stdout" 2>"$TEMP_DIR/invalid-http-listen.stderr"; then
        printf '%s\n' "[ERROR] Fail: invalid HTTP listener configuration unexpectedly succeeded" >&2
        return 1
    fi
    assert_contains "$(cat "$TEMP_DIR/invalid-http-listen.stderr")" "services.http.listen" "HTTP listener validation"
}

_teardown() {
    if [ -d "$TEMP_DIR" ]; then
        chmod -R 755 "$TEMP_DIR"
        rm -rf "$TEMP_DIR"
    fi
}

trap _teardown ERR EXIT
_setup
_test
