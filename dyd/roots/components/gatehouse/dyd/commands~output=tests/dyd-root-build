#!/usr/bin/env sh

set -eu

SRC_DIR=$DYD_STEM
DEST_DIR=$DYD_BUILD
WORK_DIR="$DEST_DIR/work"
SOURCE_DIR="$DEST_DIR/dyd/assets/source"
TESTS_DIR="$DEST_DIR/dyd/assets/tests"
PACKAGES_FILE="$DEST_DIR/packages"
MANIFEST="$DEST_DIR/dyd/assets/tests.manifest"

mkdir -p "$DEST_DIR/dyd/commands" "$WORK_DIR/config" "$WORK_DIR/configschema" "$WORK_DIR/httpservice/web" "$TESTS_DIR"
cp -R "$SRC_DIR/dyd/assets/." "$WORK_DIR"
chmod -R +w "$WORK_DIR"
cp -R "$SRC_DIR/dyd/dependencies/config-schema-codec/dyd/assets/." "$WORK_DIR/configschema"
cp "$SRC_DIR/dyd/dependencies/config-schema-json/dyd/assets/schema.json" "$WORK_DIR/config/schema.json"
cp "$SRC_DIR/dyd/dependencies/api-schema-json/dyd/assets/api.json" "$WORK_DIR/httpservice/transcript_schema.json"
cp -R "$SRC_DIR/dyd/dependencies/model-schema/dyd/assets/." "$WORK_DIR/model"
chmod -R u+w "$WORK_DIR/model"
cp -R "$SRC_DIR/dyd/dependencies/web/dyd/assets/." "$WORK_DIR/httpservice/web"
chmod -R u+w "$WORK_DIR/httpservice/web"

cd "$WORK_DIR"
GOWORK=off go list -f '{{if or .TestGoFiles .XTestGoFiles}}{{.ImportPath}}{{end}}' ./... > "$PACKAGES_FILE"
: > "$MANIFEST"
set --
while IFS= read -r package; do
	[ -n "$package" ] || continue
	test_name=${package##*/}.test
	printf '%s\t%s\n' "$package" "$test_name" >> "$MANIFEST"
	set -- "$@" "$package"
done < "$PACKAGES_FILE"

if [ "$#" -gt 0 ]; then
	GOWORK=off go test -trimpath -c -o "$TESTS_DIR/" "$@"
fi
cp -R "$WORK_DIR" "$SOURCE_DIR"
rm -rf "$WORK_DIR" "$PACKAGES_FILE"

cat > "$DEST_DIR/dyd/commands/dyd-stem-run" <<'EOF'
#!/usr/bin/env sh

set -eu

SOURCE_DIR="$DYD_STEM/dyd/assets/source"
TESTS_DIR="$DYD_STEM/dyd/assets/tests"
MANIFEST="$DYD_STEM/dyd/assets/tests.manifest"

timing=false
first=true
for argument do
	if [ "$first" = true ]; then
		set --
		first=false
	fi
	case "$argument" in
		--timing) timing=true ;;
		*) set -- "$@" "$argument" ;;
	esac
done

while IFS="$(printf '\t')" read -r package test_name; do
	case "$package" in
		gatehouse) package_dir="$SOURCE_DIR" ;;
		gatehouse/*) package_dir="$SOURCE_DIR/${package#gatehouse/}" ;;
		*)
			printf 'unexpected test package: %s\n' "$package" >&2
			exit 1
			;;
	esac
	if [ "$timing" = true ]; then
		started=$(date +%s)
		printf '=== RUN   %s\n' "$package"
		(
			cd "$package_dir"
			exec "$TESTS_DIR/$test_name" -test.v "$@"
		)
		finished=$(date +%s)
		printf '=== PASS  %s (%ss)\n' "$package" "$((finished - started))"
	else
		(
			cd "$package_dir"
			exec "$TESTS_DIR/$test_name" "$@"
		)
	fi
done < "$MANIFEST"
EOF
chmod +x "$DEST_DIR/dyd/commands/dyd-stem-run"
