#!/usr/bin/env sh

set -eu

SOURCE_DIR="$DYD_STEM/dyd/dependencies/source/dyd/assets"

mkdir -p "$DYD_BUILD/dyd/assets/source" "$DYD_BUILD/dyd/commands" "$DYD_BUILD/dyd/dependencies"
cp -R "$SOURCE_DIR/." "$DYD_BUILD/dyd/assets/source"
chmod -R u+w "$DYD_BUILD/dyd/assets/source"
ln -s "$DYD_STEM/dyd/dependencies/dependencies" "$DYD_BUILD/dyd/dependencies/dependencies"
ln -s "$DYD_STEM/dyd/dependencies/node" "$DYD_BUILD/dyd/dependencies/node"

cat > "$DYD_BUILD/dyd/commands/dyd-stem-run" <<'EOF'
#!/usr/bin/env sh

set -eu

SOURCE_DIR="$DYD_STEM/dyd/assets/source"
DEPENDENCIES_DIR="$DYD_STEM/dyd/dependencies/dependencies/dyd/assets"
NODE_DIR="$DYD_STEM/dyd/dependencies/node/dyd/assets/node/bin"
WORK_DIR="$(mktemp -d "$HOME/gatehouse-web-tests.XXXXXX")"

cleanup() {
  rm -rf "$WORK_DIR"
}
trap cleanup EXIT HUP INT TERM

cp -R "$SOURCE_DIR/." "$WORK_DIR"
chmod -R u+w "$WORK_DIR"
ln -s "$DEPENDENCIES_DIR/node_modules" "$WORK_DIR/node_modules"

cd "$WORK_DIR"
PATH="$NODE_DIR:$PATH" npm run test -- "$@"
EOF

chmod +x "$DYD_BUILD/dyd/commands/dyd-stem-run"
