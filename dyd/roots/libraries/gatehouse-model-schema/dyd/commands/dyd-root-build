#!/usr/bin/env sh

set -eu

SRC_DIR=$DYD_STEM
DEST_DIR=$DYD_BUILD
WORK_DIR="$DEST_DIR/render-work"

mkdir -p "$DEST_DIR/dyd/assets" "$DEST_DIR/dyd/traits" "$WORK_DIR"
cp -R "$SRC_DIR/dyd/assets/." "$WORK_DIR"
chmod -R +w "$WORK_DIR"
ln -s "$SRC_DIR/dyd/dependencies/dhall-codegen/dyd/assets" "$WORK_DIR/dhall-codegen"

cat > "$WORK_DIR/render.dhall" <<'EOF'
let renderer = ./dhall-codegen/renderer-golang/package.dhall

in  renderer.render renderer.options::{ package = Some "model" } ./document.dhall
EOF

dhall text --file "$WORK_DIR/render.dhall" --output "$DEST_DIR/dyd/assets/models.go"
cp "$SRC_DIR/dyd/assets/event_kinds.go" "$DEST_DIR/dyd/assets/event_kinds.go"
cat > "$WORK_DIR/render-typescript.dhall" <<'EOF'
let renderer = ./dhall-codegen/renderer-typescript/package.dhall

in  renderer.render renderer.options.default ./document.dhall
EOF

dhall text --file "$WORK_DIR/render-typescript.dhall" --output "$DEST_DIR/dyd/assets/models.ts"
rm -rf "$WORK_DIR"

printf '%s' gatehouse-model-schema > "$DEST_DIR/dyd/traits/name"
