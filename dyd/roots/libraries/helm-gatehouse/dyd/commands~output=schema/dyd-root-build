#!/usr/bin/env sh

set -eu

SRC_DIR=$DYD_STEM
DEST_DIR=$DYD_BUILD
CODEGEN="$SRC_DIR/dyd/dependencies/dhall-codegen/dyd/assets"
DHALL="$SRC_DIR/dyd/dependencies/dhall/dyd/commands/dyd-stem-run"
WORK_DIR="$DEST_DIR/render-work"

if [ ! -d "$CODEGEN/renderer-json-schema" ] || [ ! -x "$DHALL" ]; then
	printf '%s\n' 'missing dhall-codegen or Dhall dependency' >&2
	exit 1
fi

mkdir -p "$DEST_DIR/dyd/assets" "$DEST_DIR/dyd/traits" "$WORK_DIR"
cp "$SRC_DIR/dyd/assets/document.dhall" "$WORK_DIR/document.dhall"
ln -s "$CODEGEN" "$WORK_DIR/dhall-codegen"

cat > "$WORK_DIR/render.dhall" <<'EOF'
let renderer = ./dhall-codegen/renderer-json-schema/package.dhall

in  renderer.render
      renderer.options::{ variant = renderer.variant.DRAFT_07, main = Some "GatehouseHelmValues" }
      ./document.dhall
EOF

"$DHALL" text --file "$WORK_DIR/render.dhall" --output "$DEST_DIR/dyd/assets/values.schema.json"
rm -rf "$WORK_DIR"

printf '%s' helm-gatehouse-values-schema > "$DEST_DIR/dyd/traits/name"
