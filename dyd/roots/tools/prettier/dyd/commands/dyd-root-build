#!/usr/bin/env sh

set -eu

SRC_DIR=$DYD_STEM
WORK_DIR=$DYD_BUILD/npm-work

mkdir -p "$DYD_BUILD/dyd/assets" "$DYD_BUILD/dyd/commands" "$WORK_DIR"
cp "$SRC_DIR/dyd/assets/package.json" "$WORK_DIR/"
cp "$SRC_DIR/dyd/assets/package-lock.json" "$WORK_DIR/"

cd "$WORK_DIR"
node--npm ci --cache "$WORK_DIR/cache"
cp -R node_modules "$DYD_BUILD/dyd/assets/node_modules"
cp "$SRC_DIR/dyd/assets/main" "$DYD_BUILD/dyd/commands/dyd-stem-run"
rm -rf "$WORK_DIR"
